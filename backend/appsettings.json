{
  "ConnectionStrings": {
    "Default": "Data Source=frontiere-live-ge.db"
  },
  "Database": {
    "AdoptLegacySchema": false
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },
  "BotWorker": {
    "IntervalMinutes": 5
  },
  "Admin": {
    "ApiKey": ""
  },
  "Security": {
    "UseHttpsRedirection": false
  },
  "X": {
    "Enabled": false,
    "ApiBaseUrl": "https://api.x.com/2",
    "OAuthBaseUrl": "https://api.x.com/2/oauth2"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
