{
  "ConnectionStrings": {
    "Default": "Data Source=frontiere-live-ge.db"
  },
  "Database": {
    "AdoptLegacySchema": false
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },
  "BotWorker": {
    "IntervalMinutes": 5
  },
  "Traffic": {
    "SimulationEnabled": false,
    "Here": {
      "Enabled": false,
      "BaseUrl": "https://router.hereapi.com/v8/",
      "CacheSeconds": 1800,
      "MaxRequestsPerDay": 600,
      "BudgetStatePath": "data/here-usage-budget.txt",
      "WarningThresholdPercent": 75,
      "CriticalThresholdPercent": 90
    },
    "OpenTransportData": {
      "Enabled": false,
      "BaseUrl": "https://api.opentransportdata.swiss/TDP/Soap_Datex2/"
    }
  },
  "Admin": {
    "ApiKey": ""
  },
  "PreviewAccess": {
    "Enabled": false,
    "Username": "frontiere",
    "Password": ""
  },
  "Security": {
    "UseHttpsRedirection": false
  },
  "X": {
    "Enabled": false,
    "ApiBaseUrl": "https://api.x.com/2",
    "OAuthBaseUrl": "https://api.x.com/2/oauth2"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
